# Copy to `.env` and fill in. Never commit `.env`.

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=replace_me_with_python_-c_import_secrets_secrets.token_hex_32

# Database (overrides config/Connection.yaml when set)
